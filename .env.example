# Copy this file's values into your deployment host's environment variable
# settings (e.g. Vercel -> Project -> Settings -> Environment Variables).
# `npm run build` reads them via scripts/set-env.mjs to generate
# src/environments/environment.prod.ts at build time — real values never need
# to be committed to git.
#
# To test a production-style build locally, export these in your shell
# before running `npm run build` (PowerShell: `$env:EARNIVO_API_KEY = "..."`).

# The Earnivo API origin, including /api.
EARNIVO_API_BASE_URL=https://api.earnivo.example/api

# Earnivo agent panel -> the campaign -> "Website Verification" -> API Key.
# Leaving this unset disables the reward widget entirely.
EARNIVO_API_KEY=
